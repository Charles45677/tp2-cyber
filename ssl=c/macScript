# pour trouver ma mac et la mac du client
from scapy.all import *

target = '192.168.1.'

for i in range(1, 255):
    ip_dest = target + str(i)
    packet = Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip_dest)
    sendp(packet)
	
	
from scapy.all import rdpcap, ARP, get_if_addr, conf

packets = rdpcap("d.pcap")


active_pkt = set()
for pkt in packets:
    if pkt.haslayer(ARP) and pkt[ARP].op == 2:
        ip_sender = pkt[ARP].psrc
		mac = pkt[ARP].hwsrc
        active_pkt.add("{ip_sender} - {mac}")
		
for ip in sorted(active_pkt):
    print(f" - {ip}")
